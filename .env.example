# Copy this file to .env and fill in real values. Never commit .env itself.

PORT=4000

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string

# Comma-separated list of frontend origins allowed to call this API.
# Leave empty during local development to allow any origin.
# Example for production: https://www.yourdomain.com,https://yourdomain.com
ALLOWED_ORIGINS=

# From Razorpay Dashboard -> Settings -> API Keys.
# Start with the Test Mode keys (prefixed rzp_test_...) until you're ready to
# go live with real money (rzp_live_...).
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_key_secret_here

# From Razorpay Dashboard -> Settings -> Webhooks, after you create a webhook
# pointing at https://your-api-domain.com/api/payments/webhook
RAZORPAY_WEBHOOK_SECRET=
